<Window x:Class="SshDockerBackup.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SshDockerBackup.App.Views"
        xmlns:conv="clr-namespace:SshDockerBackup.App.Converters"
        Title="SSH Docker Backup"
        Height="820" Width="1180"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="SSH Docker Backup" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource SubtleText}" Margin="0" MaxWidth="900" HorizontalAlignment="Left"
                           Text="Back up Docker volumes, container configuration and project folders over SSH, with no agent on the host. Built for Synology's Container Manager, but it works with any Docker host you can reach over SSH." />
            </StackPanel>

            <Button Grid.Column="1" Content="Reset to recommended settings" VerticalAlignment="Center"
                    Padding="12,6" Margin="0,0,10,0"
                    Command="{Binding ResetSettingsCommand}"
                    ToolTip="Puts every backup and restore option back to the combination that produces a complete backup and a complete restore." />

            <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="12" Padding="12,6"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#999999" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State.IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#2EA043" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding State.ConnectionSummary}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Pages -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Connection">
                <views:ConnectionView DataContext="{Binding Connection}" />
            </TabItem>
            <TabItem Header="Containers">
                <views:ContainersView DataContext="{Binding Containers}" />
            </TabItem>
            <TabItem Header="Backup">
                <views:BackupView DataContext="{Binding Backup}" />
            </TabItem>
            <TabItem Header="Restore">
                <views:RestoreView DataContext="{Binding Restore}" />
            </TabItem>
            <TabItem Header="Log">
                <views:LogView DataContext="{Binding Log}" />
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,8" CornerRadius="6"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="{Binding Connection.HostSummary}"
                           Visibility="{Binding Connection.HostSummary, Converter={StaticResource StringToVis}}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            Visibility="{Binding State.IsOperationRunning, Converter={StaticResource BoolToVis}}">
                    <ProgressBar Width="80" Height="4" IsIndeterminate="True" VerticalAlignment="Center"
                                 Margin="0,0,8,0" />
                    <TextBlock Text="Working..." VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

<UserControl x:Class="SshDockerBackup.App.Views.ConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SshDockerBackup.App.Converters">

    <UserControl.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisConn" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="Docker host" Style="{StaticResource HeadingText}" />
            <TextBlock Style="{StaticResource SubtleText}"
                       Text="Point at any machine running Docker that you can reach over SSH. Nothing is installed on the host: every operation runs as a normal SSH command." />

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                        <TextBlock Text="Host or IP address" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="Port" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                        <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                        <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="PasswordEntry" PasswordChanged="OnPasswordChanged" />
                        <TextBlock Style="{StaticResource SubtleText}" Margin="0,6,0,0"
                                   Text="Held in memory for this session only and never written to disk. It is also what answers the sudo prompt, sent over the command's stdin rather than on the command line." />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
                        <CheckBox IsChecked="{Binding UseSudo}" Content="Run docker commands with sudo" />
                        <TextBlock Style="{StaticResource SubtleText}" Margin="24,4,0,0"
                                   Text="Required on Synology and anywhere else the account is not in the docker group." />
                    </StackPanel>
                </Grid>
            </Border>

            <Expander Header="Private key and host key" Margin="0,0,0,12">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="Private key file (optional)" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding PrivateKeyPath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0"
                                Command="{Binding BrowseForKeyCommand}" />
                    </Grid>
                    <TextBlock Style="{StaticResource SubtleText}" Margin="0,6,0,12"
                               Text="Tried before the password. If the key has a passphrase, put it in the password box." />

                    <TextBlock Text="Trusted host key (SHA256)" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" IsReadOnly="True" Text="{Binding KnownHostFingerprint}"
                                 FontFamily="Cascadia Mono, Consolas" />
                        <Button Grid.Column="1" Content="Forget" Margin="8,0,0,0"
                                Command="{Binding ClearFingerprintCommand}" />
                    </Grid>
                    <TextBlock Style="{StaticResource SubtleText}" Margin="0,6,0,0"
                               Text="Remembered the first time you connect. If it ever changes, the connection is refused rather than silently trusted." />
                </StackPanel>
            </Expander>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                <Button Content="Connect" MinWidth="120" Padding="16,6"
                        Command="{Binding ConnectCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                <Button Content="Disconnect" MinWidth="120" Padding="16,6" Margin="8,0,0,0"
                        Command="{Binding DisconnectCommand}"
                        IsEnabled="{Binding IsConnected}" />
                <ProgressBar Width="100" Height="4" IsIndeterminate="True" Margin="12,0,0,0"
                             VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConn}}" />
            </StackPanel>

            <Border Style="{StaticResource Card}" Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground" Value="#E84B3C" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding HostSummary, Converter={StaticResource StringToVis}}">
                <StackPanel>
                    <TextBlock Text="Host" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding HostSummary}" TextWrapping="Wrap" Style="{StaticResource MonoText}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

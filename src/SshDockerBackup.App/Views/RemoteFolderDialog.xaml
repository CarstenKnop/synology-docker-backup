<Window x:Class="SshDockerBackup.App.Views.RemoteFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SshDockerBackup.App.Converters"
        Title="Choose a folder on the NAS"
        Height="620" Width="760"
        MinHeight="480" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource SubtleText}"
                   Text="A USB or eSATA drive attached to the NAS is listed here as its own volume. Writing there keeps the whole backup off the network, which is considerably faster than streaming it to this PC." />

        <!-- Volumes -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" ItemsSource="{Binding Volumes}" SelectedItem="{Binding SelectedVolume}"
                      DisplayMemberPath="Display" />
            <Button Grid.Column="1" Content="Go" MinWidth="70" Margin="8,0,0,0"
                    Command="{Binding GoToVolumeCommand}" />
        </Grid>

        <!-- Current path -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding CurrentPath, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Cascadia Mono, Consolas" />
            <Button Grid.Column="1" Content="Open" MinWidth="70" Margin="8,0,0,0"
                    Command="{Binding RefreshCommand}" />
            <Button Grid.Column="2" Content="Up" MinWidth="60" Margin="8,0,0,0"
                    Command="{Binding GoUpCommand}" />
        </Grid>

        <Border Grid.Row="3" BorderThickness="1" CornerRadius="6"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <ListBox x:Name="FolderList" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                     BorderThickness="0" Background="Transparent"
                     MouseDoubleClick="OnFolderDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" Padding="2" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- New folder -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="New folder:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Text="{Binding NewFolderName, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="2" Content="Create" MinWidth="90" Margin="8,0,0,0"
                    Command="{Binding CreateFolderCommand}" IsDefault="False" />
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="{Binding FreeSpaceText}" Opacity="0.75" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusMessage}" Opacity="0.75" VerticalAlignment="Center"
                       Margin="16,0,0,0" TextWrapping="Wrap"
                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}" />
            <ProgressBar Width="80" Height="4" IsIndeterminate="True" VerticalAlignment="Center" Margin="12,0,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Use this folder" MinWidth="140" Padding="16,6" Click="OnAccept" IsDefault="True" />
            <Button Content="Cancel" MinWidth="100" Padding="16,6" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>

<UserControl x:Class="SshDockerBackup.App.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!--
            Log lines take their colour from the theme's own palette rather than from fixed values,
            so they stay readable in both light and dark. An ordinary line is plain body text;
            only the levels that need to stand out get a colour of their own.
        -->
        <Style x:Key="LogLine" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="VRB">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="DBG">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="WRN">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="ERR">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="FTL">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Log" Style="{StaticResource HeadingText}" />
            <TextBlock Style="{StaticResource SubtleText}"
                       Text="Live view of the same Serilog output that is written to disk. Every remote command is logged; the password is not, because it only ever travels over stdin." />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <CheckBox IsChecked="{Binding ShowDebug}" Content="Show debug detail" VerticalAlignment="Center" />
            <CheckBox IsChecked="{Binding AutoScroll}" Content="Follow" VerticalAlignment="Center" Margin="16,0,0,0" />
            <Separator Margin="12,0" />
            <Button Content="Copy all" MinWidth="90" Margin="0,0,6,0" Command="{Binding CopyAllCommand}" />
            <Button Content="Clear" MinWidth="70" Margin="0,0,6,0" Command="{Binding ClearCommand}" />
            <Button Content="Open log folder" MinWidth="130" Command="{Binding OpenLogFolderCommand}" />
        </StackPanel>

        <Border Grid.Row="2" BorderThickness="1" CornerRadius="6"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <ListBox x:Name="LogList" ItemsSource="{Binding Entries}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4,1" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" Style="{StaticResource LogLine}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock Grid.Row="3" Margin="0,8,0,0" Opacity="0.6" TextTrimming="CharacterEllipsis">
            <Run Text="Files:" />
            <Run Text="{Binding LogDirectory, Mode=OneWay}" />
        </TextBlock>
    </Grid>
</UserControl>

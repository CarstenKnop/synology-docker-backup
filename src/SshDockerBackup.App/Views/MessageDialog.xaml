<Window x:Class="SshDockerBackup.App.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}"
        SizeToContent="Height"
        Width="560" MinWidth="420" MaxWidth="760"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="24,22,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Heading: a coloured glyph carries the tone so the text does not have to. -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="Glyph" Grid.Column="0"
                       FontSize="22" FontWeight="Bold" VerticalAlignment="Top"
                       Margin="0,0,12,0" />

            <TextBlock x:Name="Heading" Grid.Column="1"
                       Text="{Binding DialogTitle}"
                       FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Message. Scrolls rather than growing without limit, since some of these are long. -->
        <ScrollViewer Grid.Row="1" MaxHeight="420" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="Message" TextWrapping="Wrap" LineHeight="19" />
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="PrimaryButton" MinWidth="110" Padding="16,6" Margin="0,0,8,0"
                    Click="OnPrimary" IsDefault="True" />
            <Button x:Name="SecondaryButton" MinWidth="100" Padding="16,6"
                    IsCancel="True" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>

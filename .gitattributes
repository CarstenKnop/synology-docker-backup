# Store text with LF in the repository and let Git hand each platform what it wants
# on checkout. Without this, every commit warns about line endings and the first
# contributor on Linux or macOS gets an opening diff that rewrites every line of
# every file, burying whatever they actually changed.
* text=auto

# Visual Studio rewrites these with CRLF whatever the repository says, so declaring
# it keeps the tool and Git from arguing on every save.
*.sln     text eol=crlf
*.slnx    text eol=crlf
*.csproj  text eol=crlf
*.props   text eol=crlf
*.targets text eol=crlf

# Never normalise these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.dll  binary
*.exe  binary
*.snk  binary
*.gz   binary
*.zip  binary

# Treat the two long-form documents as prose when diffing, so a reworded paragraph
# shows as changed words rather than one changed line.
*.md diff=markdown
